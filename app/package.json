{
 "name": "custom-hermes",
 "productName": "Custom Hermes",
 "version": "1.1.0",
 "main": "main.js",
 "scripts": {
  "dist": "electron-builder --win nsis"
 },
 "devDependencies": {
  "electron": "^33.2.0",
  "electron-builder": "^25.1.8"
 },
 "build": {
  "appId": "com.custom.hermes",
  "productName": "Custom Hermes",
  "files": [
   "main.js",
   "shell.html",
   "theme.css",
   "tradingMain.js",
   "trading.js",
   "trading.css",
   "vendor/**"
  ],
  "win": {
   "target": "nsis",
   "icon": "build/icon.ico"
  },
  "nsis": {
   "oneClick": true,
   "perMachine": false,
   "createDesktopShortcut": "always",
   "createStartMenuShortcut": true,
   "shortcutName": "Custom Hermes",
   "installerIcon": "build/icon.ico",
   "uninstallerIcon": "build/icon.ico",
   "installerHeaderIcon": "build/icon.ico"
  },
  "extraResources": [
   {
    "from": "build",
    "to": "icons",
    "filter": [
     "tray*",
     "icon.*"
    ]
   }
  ],
  "artifactName": "Custom-Hermes-Setup-${version}.${ext}"
 }
}