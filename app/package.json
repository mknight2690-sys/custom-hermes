{
 "name": "grok-replica",
 "productName": "Grok Replica",
 "version": "1.0.1",
 "main": "main.js",
 "scripts": {
  "dist": "electron-builder --win nsis"
 },
 "devDependencies": {
  "electron": "^33.2.0",
  "electron-builder": "^25.1.8"
 },
 "build": {
  "appId": "io.github.grokreplica",
  "productName": "Grok Replica",
  "files": [
   "main.js",
   "shell.html",
   "theme.css"
  ],
  "win": {
   "target": "nsis",
   "icon": "build/icon.ico"
  },
  "nsis": {
   "oneClick": true,
   "perMachine": false,
   "createDesktopShortcut": "always",
   "createStartMenuShortcut": true,
   "shortcutName": "Grok Replica",
   "installerIcon": "build/icon.ico",
   "uninstallerIcon": "build/icon.ico",
   "installerHeaderIcon": "build/icon.ico"
  },
  "extraResources": [
   {
    "from": "build",
    "to": "icons",
    "filter": [
     "tray*",
     "icon.*"
    ]
   }
  ]
 }
}